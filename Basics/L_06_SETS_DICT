#Frequency count using dictionary

list1 = [2,2,4,4,5,5,5,9]
freq = {}
for i in list1:
  if i in freq:
    freq[i] +=1
  else:
    freq[i]=1

for i,j in freq.items():
  print(f"{i} is {j} times")



