#Sliding windows
#used to find all possible subarrays in O(N) instead O(N*N)
# arr2=[1,2,3,4,5,6]
# for i in range(0,len(arr2)):
#     for j in range(i,len(arr2)):
#         print(f"{arr2[j]}")
arr = [1,2,3,4,5,6]
k = 3

window_sum = sum(arr[:k])

print(window_sum)

for i in range(k, len(arr)):
    window_sum += arr[i]
    window_sum -= arr[i-k]
    
