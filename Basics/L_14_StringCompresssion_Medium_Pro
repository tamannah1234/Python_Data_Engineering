def strCompress(chars):
    #two pointers
    n = len(chars)
    i =0
    write=0
    while i<n:
        ch = chars[i]
        count = 0
        
        #count consecutive occurence
        while i<n and chars[i]==ch:
            count +=1
            i +=1
            
        #write the character
        chars[write] = ch
        write +=1
        
        #write count if greater than 1 
        if count>1:
            for digit in str(count):
                chars[write]=digit
                write +=1
    return chars
    
res=strCompress(["a","a","b","b","c"])
print("".join(res[:]))
