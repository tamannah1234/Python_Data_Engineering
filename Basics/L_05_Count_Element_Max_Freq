class Solution:
    def maxFrequencyElements(self, nums: List[int]) -> int:
        freq={}
        max_freq=0
        for i in nums:
            if i in freq:
                freq[i] +=1
            else:
                freq[i]=1
        
        for i in freq.values():
            if i>max_freq:
                max_freq = i
        count=0
        for i in freq.values():
            if i==max_freq:
                count +=i
        return count

        
