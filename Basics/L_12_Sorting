#TC = O(N*N)
#Selection sorted
arr = [10,20,2,40,3]
for i in range(len(arr)):
    for j in range(i+1,len(arr)):
        if arr[i]>arr[j]:
            arr[i],arr[j]=arr[j],arr[i]

print(arr)

#Bubble sorted
arr1 = [10,20,2,40,3]
n=len(arr1)
for i in range(n):
    for j in range(0,n-i-1):
        if arr1[j]>arr1[j+1]:
            arr1[j],arr1[j+1]=arr1[j+1],arr1[j]

print(arr1)

#Insertion sorted
arr2 = [10,20,2,40,3]
for i in range(1,len(arr2)):
    key = arr2[i]
    j = i-1 #prev
    
    while j>=0 and arr2[j]>key:
        arr2[j+1]=arr2[j]
        j -=1
    arr2[j+1]= key
    
print(arr2)
    
    
 
