#Prefix sum 
arr4=[1,2,3,4,5,6,7]
n = len(arr4)
prefix = [0]*n
prefix[0]=arr4[0]
for i in range(1,n):
    prefix[i]=prefix[i-1]+arr4[i]
print(prefix)
